<launch>
  <!-- Five isolated arm drivers plus the fail-closed Task2 coordinator. -->
  <arg name="front_mode" default="1" />
  <arg name="front_auto_enable" default="true" />
  <arg name="mid_mode" default="1" />
  <arg name="mid_auto_enable" default="true" />
  <arg name="rear_initial_role" default="slave" />
  <arg name="rear_auto_enable" default="true" />

  <include file="$(dirname)/start_ms_piper_5arm_task2.launch">
    <arg name="front_mode" value="$(arg front_mode)" />
    <arg name="front_auto_enable" value="$(arg front_auto_enable)" />
    <arg name="mid_mode" value="$(arg mid_mode)" />
    <arg name="mid_auto_enable" value="$(arg mid_auto_enable)" />
    <arg name="rear_initial_role" value="$(arg rear_initial_role)" />
    <arg name="rear_auto_enable" value="$(arg rear_auto_enable)" />
  </include>

  <node name="task2_handover" pkg="piper" type="task2_handover_node.py" output="screen">
    <param name="command_max_age_sec" value="0.25" />
    <param name="pair_max_skew_sec" value="0.02" />
    <param name="joint_sync_tolerance_rad" value="0.05" />
    <param name="gripper_sync_tolerance_m" value="0.015" />
    <param name="feedback_max_age_sec" value="0.10" />
    <param name="role_timeout_sec" value="1.0" />
    <param name="motion_ready_timeout_sec" value="5.0" />
    <param name="master_feedback_timeout_sec" value="1.0" />
  </node>
</launch>
