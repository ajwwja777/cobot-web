<launch>
  <!-- Front/mid drivers only. The terminal process owns rear CAN feedback and
       verified drag-teaching entry; no stock rear drivers or button coordinator. -->
  <node name="piper_record_replay_left" pkg="piper" type="piper_start_ms_node.py" output="screen" required="true">
    <param name="can_port" value="can_left" />
    <param name="mode" value="1" />
    <param name="auto_enable" value="true" />
    <remap from="/puppet/joint_states" to="/puppet/joint_left" />
    <remap from="/master/joint_states" to="/master/joint_left" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_left" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_left" />
    <remap from="/enable_flag" to="/rear_record_replay/unused_enable_left" />
    <remap from="pos_cmd" to="/rear_record_replay/unused_pos_left" />
  </node>
  <node name="piper_record_replay_right" pkg="piper" type="piper_start_ms_node.py" output="screen" required="true">
    <param name="can_port" value="can_right" />
    <param name="mode" value="1" />
    <param name="auto_enable" value="true" />
    <remap from="/puppet/joint_states" to="/puppet/joint_right" />
    <remap from="/master/joint_states" to="/master/joint_right" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_right" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_right" />
    <remap from="/enable_flag" to="/rear_record_replay/unused_enable_right" />
    <remap from="pos_cmd" to="/rear_record_replay/unused_pos_right" />
  </node>
  <node name="piper_record_replay_mid" pkg="piper" type="piper_start_ms_node.py" output="screen" required="true">
    <param name="can_port" value="can_mid" />
    <param name="mode" value="1" />
    <param name="auto_enable" value="true" />
    <remap from="/puppet/joint_states" to="/puppet/joint_mid" />
    <remap from="/master/joint_states" to="/master/joint_mid" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_mid" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_mid" />
    <remap from="/enable_flag" to="/rear_record_replay/unused_enable_mid" />
    <remap from="pos_cmd" to="/rear_record_replay/unused_pos_mid" />
  </node>
</launch>
