<launch>
  <!--
    Task2 five-arm inference driver.

    Front-left, front-right and middle arms reuse piper_start_ms_node.py.
    Rear-left and rear-right each own an independent CAN interface through
    piper_rear_role_task2_node.py and start as motion-output/slave arms.

    This launch only provides drivers. A later handover node will duplicate
    policy commands to the rear arms and coordinate M/S source switching.
  -->

  <arg name="front_mode" default="1" />
  <arg name="front_auto_enable" default="true" />
  <arg name="mid_mode" default="1" />
  <arg name="mid_auto_enable" default="true" />
  <arg name="rear_initial_role" default="slave" />
  <arg name="rear_auto_enable" default="true" />
  <arg name="rear_publish_rate" default="200.0" />
  <arg name="rear_command_timeout_sec" default="0.25" />
  <arg name="rear_role_verify_timeout_sec" default="1.0" />
  <arg name="rear_enable_verify_timeout_sec" default="5.0" />
  <arg name="rear_feedback_timeout_sec" default="0.25" />

  <node name="$(anon piper_left)" pkg="piper" type="piper_start_ms_node.py" output="screen">
    <param name="can_port" value="can_left" />
    <param name="mode" value="$(arg front_mode)" />
    <param name="auto_enable" value="$(arg front_auto_enable)" />
    <remap from="/puppet/joint_states" to="/puppet/joint_left" />
    <remap from="/master/joint_states" to="/master/joint_left" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_left" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_left" />
  </node>

  <node name="$(anon piper_right)" pkg="piper" type="piper_start_ms_node.py" output="screen">
    <param name="can_port" value="can_right" />
    <param name="mode" value="$(arg front_mode)" />
    <param name="auto_enable" value="$(arg front_auto_enable)" />
    <remap from="/puppet/joint_states" to="/puppet/joint_right" />
    <remap from="/master/joint_states" to="/master/joint_right" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_right" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_right" />
  </node>

  <node name="$(anon piper_mid)" pkg="piper" type="piper_start_ms_node.py" output="screen">
    <param name="can_port" value="can_mid" />
    <param name="mode" value="$(arg mid_mode)" />
    <param name="auto_enable" value="$(arg mid_auto_enable)" />
    <remap from="/puppet/joint_states" to="/puppet/joint_mid" />
    <remap from="/master/joint_states" to="/master/joint_mid" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_mid" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_mid" />
  </node>

  <node name="piper_rear_left_task2" pkg="piper" type="piper_rear_role_task2_node.py" output="screen">
    <param name="can_port" value="can_rear_left" />
    <param name="initial_role" value="$(arg rear_initial_role)" />
    <param name="auto_enable" value="$(arg rear_auto_enable)" />
    <param name="gripper_exist" value="true" />
    <param name="publish_rate" value="$(arg rear_publish_rate)" />
    <param name="command_timeout_sec" value="$(arg rear_command_timeout_sec)" />
    <param name="role_verify_timeout_sec" value="$(arg rear_role_verify_timeout_sec)" />
    <param name="enable_verify_timeout_sec" value="$(arg rear_enable_verify_timeout_sec)" />
    <param name="feedback_timeout_sec" value="$(arg rear_feedback_timeout_sec)" />
    <remap from="~joint_cmd" to="/task2/rear_left/joint_cmd" />
    <remap from="~joint_states" to="/task2/rear_left/joint_states" />
    <remap from="~master_joint" to="/task2/rear_left/master_joint" />
    <remap from="~role" to="/task2/rear_left/role" />
    <remap from="~arm_status" to="/task2/rear_left/arm_status" />
    <remap from="~motion_ready" to="/task2/rear_left/motion_ready" />
    <remap from="~set_master" to="/task2/rear_left/set_master" />
  </node>

  <node name="piper_rear_right_task2" pkg="piper" type="piper_rear_role_task2_node.py" output="screen">
    <param name="can_port" value="can_rear_right" />
    <param name="initial_role" value="$(arg rear_initial_role)" />
    <param name="auto_enable" value="$(arg rear_auto_enable)" />
    <param name="gripper_exist" value="true" />
    <param name="publish_rate" value="$(arg rear_publish_rate)" />
    <param name="command_timeout_sec" value="$(arg rear_command_timeout_sec)" />
    <param name="role_verify_timeout_sec" value="$(arg rear_role_verify_timeout_sec)" />
    <param name="enable_verify_timeout_sec" value="$(arg rear_enable_verify_timeout_sec)" />
    <param name="feedback_timeout_sec" value="$(arg rear_feedback_timeout_sec)" />
    <remap from="~joint_cmd" to="/task2/rear_right/joint_cmd" />
    <remap from="~joint_states" to="/task2/rear_right/joint_states" />
    <remap from="~master_joint" to="/task2/rear_right/master_joint" />
    <remap from="~role" to="/task2/rear_right/role" />
    <remap from="~arm_status" to="/task2/rear_right/arm_status" />
    <remap from="~motion_ready" to="/task2/rear_right/motion_ready" />
    <remap from="~set_master" to="/task2/rear_right/set_master" />
  </node>
</launch>
