<launch>


  <arg name="front_mode" default="1" />
  <arg name="front_auto_enable" default="true" />
  <arg name="mid_mode" default="1" />
  <arg name="mid_auto_enable" default="true" />
  <arg name="rear_auto_enable" default="true" />

  <arg name="rear_idle_disabled" default="true" />
  <arg name="rear_publish_rate" default="200.0" />
  <arg name="rear_command_timeout_sec" default="0.25" />
  <arg name="rear_feedback_timeout_sec" default="0.25" />
  <arg name="rear_teach_stability_sec" default="0.2" />
  <arg name="rear_max_hold_delta_rad" default="0.60" />
  <arg name="rear_move_speed_percent" default="20" />
  <arg name="rear_state_publish_rate" default="10.0" />

  <node name="$(anon piper_left)" pkg="piper" type="piper_start_ms_node.py" output="screen">
    <param name="can_port" value="can_left" />
    <param name="mode" value="$(arg front_mode)" />
    <param name="auto_enable" value="$(arg front_auto_enable)" />
    <remap from="/puppet/joint_states" to="/puppet/joint_left" />
    <remap from="/master/joint_states" to="/master/joint_left" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_left" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_left" />
  </node>

  <node name="$(anon piper_right)" pkg="piper" type="piper_start_ms_node.py" output="screen">
    <param name="can_port" value="can_right" />
    <param name="mode" value="$(arg front_mode)" />
    <param name="auto_enable" value="$(arg front_auto_enable)" />
    <remap from="/puppet/joint_states" to="/puppet/joint_right" />
    <remap from="/master/joint_states" to="/master/joint_right" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_right" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_right" />
  </node>

  <node name="$(anon piper_mid)" pkg="piper" type="piper_start_ms_node.py" output="screen">
    <param name="can_port" value="can_mid" />
    <param name="mode" value="$(arg mid_mode)" />
    <param name="auto_enable" value="$(arg mid_auto_enable)" />
    <remap from="/puppet/joint_states" to="/puppet/joint_mid" />
    <remap from="/master/joint_states" to="/master/joint_mid" />
    <remap from="/puppet/end_pose" to="/puppet/end_pose_mid" />
    <remap from="/puppet/arm_status" to="/puppet/arm_status_mid" />
  </node>

  <node name="piper_rear_left_teach_task2" pkg="cobot_platform_arms" type="piper_rear_teach_task2_node.py" output="screen">
    <param name="can_port" value="can_rear_left" />
    <param name="auto_enable" value="$(arg rear_auto_enable)" />
    <param name="idle_disabled" value="$(arg rear_idle_disabled)" />
    <param name="gripper_exist" value="true" />
    <param name="publish_rate" value="$(arg rear_publish_rate)" />
    <param name="command_timeout_sec" value="$(arg rear_command_timeout_sec)" />
    <param name="feedback_timeout_sec" value="$(arg rear_feedback_timeout_sec)" />
    <param name="teach_stability_sec" value="$(arg rear_teach_stability_sec)" />
    <param name="max_hold_delta_rad" value="$(arg rear_max_hold_delta_rad)" />
    <param name="move_speed_percent" value="$(arg rear_move_speed_percent)" />
    <param name="state_publish_rate" value="$(arg rear_state_publish_rate)" />
    <remap from="~joint_cmd" to="/task2/teach/rear_left/joint_cmd" />
    <remap from="~joint_states" to="/task2/teach/rear_left/joint_states" />
    <remap from="~arm_status" to="/task2/teach/rear_left/arm_status" />
    <remap from="~teach_active" to="/task2/teach/rear_left/teach_active" />
    <remap from="~motion_ready" to="/task2/teach/rear_left/motion_ready" />
    <remap from="~fault" to="/task2/teach/rear_left/fault" />
    <remap from="~reset_fault" to="/task2/teach/rear_left/reset_fault" />
    <remap from="~home" to="/task2/teach/rear_left/home" />
  <remap from="~recover_idle" to="/task2/teach/rear_left/recover_idle" /></node>

  <node name="piper_rear_right_teach_task2" pkg="cobot_platform_arms" type="piper_rear_teach_task2_node.py" output="screen">
    <param name="can_port" value="can_rear_right" />
    <param name="auto_enable" value="$(arg rear_auto_enable)" />
    <param name="idle_disabled" value="$(arg rear_idle_disabled)" />
    <param name="gripper_exist" value="true" />
    <param name="publish_rate" value="$(arg rear_publish_rate)" />
    <param name="command_timeout_sec" value="$(arg rear_command_timeout_sec)" />
    <param name="feedback_timeout_sec" value="$(arg rear_feedback_timeout_sec)" />
    <param name="teach_stability_sec" value="$(arg rear_teach_stability_sec)" />
    <param name="max_hold_delta_rad" value="$(arg rear_max_hold_delta_rad)" />
    <param name="move_speed_percent" value="$(arg rear_move_speed_percent)" />
    <param name="state_publish_rate" value="$(arg rear_state_publish_rate)" />
    <remap from="~joint_cmd" to="/task2/teach/rear_right/joint_cmd" />
    <remap from="~joint_states" to="/task2/teach/rear_right/joint_states" />
    <remap from="~arm_status" to="/task2/teach/rear_right/arm_status" />
    <remap from="~teach_active" to="/task2/teach/rear_right/teach_active" />
    <remap from="~motion_ready" to="/task2/teach/rear_right/motion_ready" />
    <remap from="~fault" to="/task2/teach/rear_right/fault" />
    <remap from="~reset_fault" to="/task2/teach/rear_right/reset_fault" />
    <remap from="~home" to="/task2/teach/rear_right/home" />
  <remap from="~recover_idle" to="/task2/teach/rear_right/recover_idle" /></node>

  <node name="task2_teach_handover" pkg="cobot_platform_arms" type="teach_handover.py" output="screen">
    <param name="command_max_age_sec" value="0.25" />
    <param name="feedback_max_age_sec" value="0.10" />
    <param name="manual_forward_rate" value="200.0" />
    <param name="feedback_gap_fault_sec" value="1.0" />
  </node>
</launch>
